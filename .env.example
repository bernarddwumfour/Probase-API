# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081

# Database
DATABASE_URL=postgresql://probase:probase@localhost:5432/probase?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Mail
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ProBase <no-reply@probase.local>"

# Social login
GOOGLE_CLIENT_IDS=

# Optional, used only by `npm run db:seed`
# SEED_ADMIN_EMAIL=admin@probase.local
# SEED_ADMIN_PASSWORD=use-a-long-random-password

# File storage: "local" writes to STORAGE_LOCAL_DIR (development only), "s3" uses S3, R2 or MinIO
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Must be reachable from the phone. Use your computer's LAN address (http://192.168.x.x:3000) on a real device.
PUBLIC_BASE_URL=http://localhost:3000
# Only for STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=
# S3_PUBLIC_BASE_URL=