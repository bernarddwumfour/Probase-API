generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  customer
  professional
}

enum SystemRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
}

enum AuthProvider {
  google
  facebook
}

enum OtpPurpose {
  email_verify
  password_reset
}

enum DevicePlatform {
  ios
  android
}

enum VerificationStatus {
  unverified
  pending
  approved
  rejected
}

enum RateUnit {
  hour
  job
  day
}

enum UploadPurpose {
  avatar
  portfolio
  verification
}

enum UploadStatus {
  pending
  consumed
}

enum BookingStatus {
  pending
  confirmed
  declined
  cancelled
  in_progress
  completed
}

enum BookingLocationType {
  saved
  custom
  professional
}

enum RescheduleStatus {
  pending
  accepted
  declined
  withdrawn
}

// ---------- Identity ----------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String
  email           String     @unique // always stored trimmed + lowercased
  passwordHash    String? // null for social-only accounts
  phone           String? // E.164, e.g. +233...
  avatarUrl       String?
  emailVerifiedAt DateTime?
  activeRole      Role? // null until a role is onboarded
  systemRole      SystemRole @default(user)
  language        String     @default("en")
  status          UserStatus @default(active)
  termsAcceptedAt DateTime?
  termsVersion    String?
  lastLoginAt     DateTime?
  deletedAt       DateTime? // soft delete; PII is anonymised
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  uploads         Upload[]

  customerProfile     CustomerProfile?
  professionalProfile ProfessionalProfile?
  identities          AuthIdentity[]
  otpCodes            OtpCode[]
  refreshSessions     RefreshSession[]
  deviceTokens        DeviceToken[]
  notifications       Notification[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  email          String? // email the provider reported, for auditing
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_codes")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid // all rotations of one login share this
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  rotatedAt  DateTime? // set when exchanged for a new token
  revokedAt  DateTime? // set on logout or family revocation
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model DeviceToken {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  expoPushToken String         @unique
  platform      DevicePlatform
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ---------- Lookups ----------

model Profession {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  iconUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferredBy   CustomerPreferredProfession[]
  professionals ProfessionalProfile[]

  @@map("professions")
}

// ---------- Customer side ----------

model CustomerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredProfessions CustomerPreferredProfession[]
  savedLocations       SavedLocation[]
  savedProfessionals   SavedProfessional[]
  bookings             Booking[]

  @@map("customer_profiles")
}

model CustomerPreferredProfession {
  customerId   String   @db.Uuid
  professionId String   @db.Uuid
  createdAt    DateTime @default(now())

  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  profession Profession      @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@id([customerId, professionId])
  @@map("customer_preferred_professions")
}

model SavedLocation {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @db.Uuid
  name           String
  latitude       Float
  longitude      Float
  address        String?
  searchRadiusKm Int      @default(2)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("saved_locations")
}

// ---------- Professional side ----------

model ProfessionalProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @unique @db.Uuid
  businessName        String
  professionId        String             @db.Uuid
  description         String?
  latitude            Float
  longitude           Float
  address             String?
  operationalRadiusKm Int                @default(5)
  verificationStatus  VerificationStatus @default(unverified)
  ratingAverage       Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount         Int                @default(0)
  onboardedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession         Profession          @relation(fields: [professionId], references: [id])
  workingDays        WorkingDay[]
  services           Service[]
  savedProfessionals SavedProfessional[]
  bookings           Booking[]

  @@index([professionId])
  @@map("professional_profiles")
}

model WorkingDay {
  id             String   @id @default(uuid()) @db.Uuid
  professionalId String   @db.Uuid
  dayOfWeek      Int // 0 = Sunday ... 6 = Saturday
  isOpen         Boolean
  opensAt        String? // "HH:mm", set only when open
  closesAt       String? // "HH:mm", set only when open
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, dayOfWeek])
  @@map("working_days")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  professionalId String   @db.Uuid
  name           String
  description    String?
  rate           Decimal  @db.Decimal(10, 2)
  rateUnit       RateUnit
  currency       String   @default("GHS")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  bookingServices BookingService[]

  @@index([professionalId])
  @@map("services")
}

model Upload {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  purpose     UploadPurpose
  key         String        @unique
  contentType String
  sizeBytes   Int
  status      UploadStatus  @default(pending)
  expiresAt   DateTime // last moment it can be attached
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("uploads")
}

model SavedProfessional {
  customerId     String   @db.Uuid
  professionalId String   @db.Uuid
  createdAt      DateTime @default(now())

  customer     CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([customerId, professionalId])
  @@index([professionalId])
  @@map("saved_professionals")
}

// ---------- Bookings ----------

model Booking {
  id             String               @id @default(uuid()) @db.Uuid
  customerId     String               @db.Uuid
  professionalId String               @db.Uuid
  status         BookingStatus        @default(pending)
  note           String?
  preferredAt    DateTime?
  scheduledAt    DateTime?
  locationType   BookingLocationType?
  locationName   String?
  address        String?
  latitude       Float?
  longitude      Float?
  statusReason   String?
  confirmedAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  customer     CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  services     BookingService[]
  reschedules  RescheduleRequest[]

  @@index([customerId, status, createdAt])
  @@index([professionalId, status, createdAt])
  @@map("bookings")
}

model BookingService {
  id               String    @id @default(uuid()) @db.Uuid
  bookingId        String    @db.Uuid
  serviceId        String?   @db.Uuid
  nameSnapshot     String
  rateSnapshot     Decimal?  @db.Decimal(10, 2)
  rateUnitSnapshot RateUnit?
  currencySnapshot String?
  isOther          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_services")
}

model RescheduleRequest {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @db.Uuid
  proposedBy  Role
  proposedAt  DateTime
  note        String?
  status      RescheduleStatus @default(pending)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("reschedule_requests")
}

// ---------- Notifications ----------

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  kind      String
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
